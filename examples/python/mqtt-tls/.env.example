# Official Seu IoT API (HTTPS, no trailing slash).
SIOT_API_BASE_URL=https://seuiot.com.br:8000

# API key of your API contract (sent as "Authorization: Bearer <key>").
# Paste the full value, including the "siot_" prefix.
SIOT_API_KEY=siot_paste_your_key_here

# Official broker: mqtt.seuiot.com.br (the host is returned by POST /external/v1/mqtt-credentials).
# Port of the native MQTT-over-TLS (mqtts) listener. It is NOT part of the
# credentials response; 8883 is the official port.
SIOT_MQTT_TLS_PORT=8883
